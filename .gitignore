edge/out/

# TLS: private keys and intermediates NEVER go to git (public .crt files are fine)
tls/out/*.key
tls/out/*.csr
tls/out/*.srl
tls/out/*.ext

.DS_Store
__pycache__/
tls/out/bundle.pem

# screen recordings are too big for git - they go to Google Drive
*.mov
*.mp4
