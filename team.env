# ---------------------------------------------------------------------------
# team.env  -  the ONE file every machine reads. Must be IDENTICAL on all 3 Macs.
# ---------------------------------------------------------------------------

# Team identity  (TEAM_ID: lowercase, no spaces -> the domain becomes <TEAM_ID>.test)
TEAM_NAME="teamX"
TEAM_ID="teamx"
DOMAIN="${TEAM_ID}.test"

# Three Macs, four roles (PDF section 3: "Teams of 2-3 may combine machine roles")
#   Mac 1 (Person 1) = DNS server + test client
#   Mac 2 (Person 2) = Edge (nginx, TLS, load balancer) + Backend A
#   Mac 3 (Person 3) = Backend B + test client (Wireshark)
# Find each Mac's IP with:  ipconfig getifaddr en0
P1_IP="10.7.26.168"     # <- Person 1's Mac --> Yash
P2_IP="10.7.25.181"     # <- Person 2's Mac --> Samadhiya
P3_IP="10.7.23.23"

MAC1_IP="${P1_IP}"  # DNS server (dnsmasq)
MAC2_IP="${P2_IP}"  # Edge: nginx reverse proxy + load balancer + TLS
MAC3_IP="${P2_IP}"  # Backend A  :3001  (runs on Mac 2)
MAC4_IP="${P3_IP}"  # Backend B  :3002 + test client
DNS_MAC="Mac 1 (Person 1)"; EDGE_MAC="Mac 2 (Person 2)"; A_MAC="Mac 2 (Person 2)"; B_MAC="Mac 3 (Person 3)"

# Ports
BACKEND_A_PORT=3001
BACKEND_B_PORT=3002
HTTPS_PORT=443              # use 8443 if a Mac refuses to bind 443
HTTP_PORT=80                # use 8080 if a Mac refuses to bind 80

# DNS
UPSTREAM_DNS="8.8.8.8"      # where Mac 1 forwards everything that is NOT *.DOMAIN
DNS_TTL=60                  # TTL (seconds) on our records - visible in dig output

# Used only by the failure demos: a real Mac with NO DNS server and NOTHING on :443
WRONG_IP="${P3_IP}"
